<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Services</title>
  <link rel="stylesheet" href="/admin/css/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.4/css/all.min.css" integrity="sha512-rOO6c0BsLqTbzD1Ov8gAvvl+Isncm0BLBQ8tJQ+El+3LkDR3bZ+vUlrDcnMwKMW+KcmVjxXnxWvl6N9Yt+JkGg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="admin-shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="sidebar-brand">Admin Panel</div>
      <button id="sidebarToggle" class="sidebar-toggle"><i class="fa fa-chevron-left"></i></button>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-group">
        <div class="nav-group-title">Content</div>
        <a href="/admin" class="nav-item">Dashboard</a>
        <a href="/admin/services" class="nav-item active">Services</a>
        <a href="/admin/gallery" class="nav-item">Gallery</a>
        <a href="/admin/messages" class="nav-item">Messages</a>
        <a href="/admin/about" class="nav-item">About</a>
      </div>
    </nav>
  </aside>

  <div class="main-panel">
    <header class="topbar">
      <div class="topbar-left">
        <div class="site-logo">Rajan Adhikari</div>
      </div>
      <div class="topbar-right">
        <div class="user-menu">
          <img src="https://via.placeholder.com/36" alt="avatar" class="avatar" />
          <span>Admin</span>
        </div>
      </div>
    </header>

    <main class="admin-content">
      <% if (flash) { %>
        <div class="toast <%= flash.type %>"><%= flash.message %></div>
      <% } %>
      <div class="page-header">
        <h2>Services</h2>
        <a href="/admin/services/new" class="btn btn-primary">Add New Service</a>
      </div>
      <div class="content-card">
        <% services.forEach((service) => { %>
          <div class="list-item">
            <div>
              <h3><%= service.title %></h3>
              <p><%= service.description.slice(0, 120) %>...</p>
            </div>
            <div class="item-actions">
              <a href="/admin/services/<%= service._id %>/edit" class="btn btn-secondary">Edit</a>
              <form method="POST" action="/admin/services/<%= service._id %>/delete" onsubmit="return confirm('Delete this service?');">
                <button class="btn btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </div>
  <script src="/admin/js/script.js"></script>
</body>
</html>
