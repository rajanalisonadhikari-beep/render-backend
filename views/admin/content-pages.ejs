<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Content — Admin</title>
  <link rel="stylesheet" href="/admin/admin.css" />
</head>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar', { active: 'content' }) %>

    <div class="admin-main">
      <div class="admin-topbar">
        <h1>Site Content</h1>
      </div>

      <div class="admin-content">
        <p style="color:var(--text-muted); margin-top:0 0 18px;">
          Pick a page below to edit its text, paragraphs, and images.
        </p>

        <div class="card-grid">
          <% pages.forEach(function(p) { %>
            <a class="page-card" href="/admin/content/<%= p.slug %>">
              <div>
                <div class="title"><%= p.label %></div>
                <div class="sub"><%= p.slug %>.html</div>
              </div>
              <div class="chevron">→</div>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
