<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #111827; color: #f9fafb; display: grid; place-items: center; min-height: 100vh; }
      .card { background: #fff; color: #111827; padding: 2rem; border-radius: 16px; width: min(90vw, 420px); box-shadow: 0 20px 50px rgba(0,0,0,0.25); }
      form { display: grid; gap: 0.8rem; }
      input { padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 10px; }
      button { padding: 0.8rem 1rem; background: #2563eb; color: #fff; border: none; border-radius: 10px; cursor: pointer; }
      .flash { margin-bottom: 1rem; padding: 0.75rem; border-radius: 10px; } .flash.error { background: #fee2e2; color: #b91c1c; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Admin Login</h1>
      <% if (flash) { %>
        <div class="flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <label>Username<input type="text" name="username" required /></label>
        <label>Password<input type="password" name="password" required /></label>
        <button type="submit">Login</button>
      </form>
    </div>
  </body>
</html>
