<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f3f4f6; color: #111827; }
      .shell { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem 3rem; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .card { background: #fff; border-radius: 14px; padding: 1rem 1.2rem; box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
      .actions a { display: inline-block; margin-right: 0.5rem; margin-top: 0.5rem; text-decoration: none; color: #2563eb; }
      .flash { padding: 0.75rem 1rem; border-radius: 10px; margin-bottom: 1rem; }
      .flash.success { background: #dcfce7; color: #166534; }
      .flash.error { background: #fee2e2; color: #b91c1c; }
    </style>
  </head>
  <body>
    <div class="shell">
      <h1>Dashboard</h1>
      <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
      <div class="grid">
        <div class="card">
          <h2>Posts</h2>
          <p><a href="/admin/posts">Manage posts</a></p>
          <p><a href="/admin/posts/new">Create new post</a></p>
        </div>
        <div class="card">
          <h2>Messages</h2>
          <p><a href="/admin/messages">Review messages</a></p>
        </div>
      </div>
      <div class="card" style="margin-top: 1rem;">
        <h2>Recent posts</h2>
        <% posts.forEach((post) => { %>
          <div style="padding:0.5rem 0; border-bottom:1px solid #e5e7eb;"> <strong><%= post.title %></strong> — <%= post.slug %></div>
        <% }) %>
      </div>
      <div class="card" style="margin-top: 1rem;">
        <h2>Recent messages</h2>
        <% messages.forEach((message) => { %>
          <div style="padding:0.5rem 0; border-bottom:1px solid #e5e7eb;"> <strong><%= message.name %></strong> — <%= message.email %> <div><%= message.message %></div></div>
        <% }) %>
      </div>
      <p><a href="/admin/logout">Logout</a></p>
    </div>
  </body>
</html>
