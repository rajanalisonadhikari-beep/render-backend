<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/admin/admin.css" />
</head>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar', { active: 'dashboard' }) %>

    <div class="admin-main">
      <div class="admin-topbar">
        <h1>Dashboard</h1>
      </div>

      <div class="admin-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="card" style="margin-bottom:16px; background:<%= flash.type === 'success' ? 'var(--success-light)' : 'var(--danger-light)' %>; border:none;">
            <span style="color:<%= flash.type === 'success' ? 'var(--success)' : 'var(--danger)' %>; font-weight:600; font-size:13px;">
              <%= flash.message %>
            </span>
          </div>
        <% } %>

        <div class="card-grid">
          <div class="card">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
              <strong>Posts</strong>
            </div>
            <a class="btn btn-ghost btn-sm" href="/admin/posts" style="margin-right:8px;">Manage posts</a>
            <a class="btn btn-primary btn-sm" href="/admin/posts/new">Create new post</a>
          </div>

          <div class="card">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
              <strong>Messages</strong>
            </div>
            <a class="btn btn-ghost btn-sm" href="/admin/messages">Review messages</a>
          </div>

          <div class="card">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
              <strong>Site Content</strong>
            </div>
            <a class="btn btn-primary btn-sm" href="/admin/content">Edit site content</a>
          </div>
        </div>

        <div class="card" style="margin-top:20px;">
          <strong>Recent posts</strong>
          <% if (!posts || posts.length === 0) { %>
            <p style="color:var(--text-faint); font-size:13px; margin:10px 0 0;">No posts yet.</p>
          <% } else { %>
            <% posts.forEach(function(post) { %>
              <div style="padding:10px 0; border-bottom:1px solid var(--border); font-size:13.5px;">
                <strong><%= post.title %></strong>
                <span style="color:var(--text-faint);"> — <%= post.slug %></span>
              </div>
            <% }); %>
          <% } %>
        </div>

        <div class="card">
          <strong>Recent messages</strong>
          <% if (!messages || messages.length === 0) { %>
            <p style="color:var(--text-faint); font-size:13px; margin:10px 0 0;">No messages yet.</p>
          <% } else { %>
            <% messages.forEach(function(message) { %>
              <div style="padding:10px 0; border-bottom:1px solid var(--border); font-size:13.5px;">
                <strong><%= message.name %></strong>
                <span style="color:var(--text-faint);"> — <%= message.email %></span>
                <div style="color:var(--text-muted); margin-top:4px;"><%= message.message %></div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
