<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Posts</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f3f4f6; color: #111827; }
      .shell { max-width: 1000px; margin: 0 auto; padding: 2rem 1rem 3rem; }
      .card { background: #fff; border-radius: 14px; padding: 1rem 1.2rem; box-shadow: 0 8px 24px rgba(0,0,0,0.08); margin-bottom: 1rem; }
      .actions a, .actions button { text-decoration: none; color: #2563eb; background: #eff6ff; border: none; padding: 0.5rem 0.75rem; border-radius: 8px; cursor: pointer; margin-right: 0.5rem; }
      .delete { color: #b91c1c; background: #fee2e2; }
      .flash { padding: 0.75rem 1rem; border-radius: 10px; margin-bottom: 1rem; }
      .flash.success { background: #dcfce7; color: #166534; }
    </style>
  </head>
  <body>
    <div class="shell">
      <h1>Posts</h1>
      <p><a href="/admin/posts/new">Create post</a> • <a href="/admin">Dashboard</a></p>
      <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
      <% posts.forEach((post) => { %>
        <div class="card">
          <h2><%= post.title %></h2>
          <p><%= post.slug %></p>
          <div class="actions">
            <a href="/admin/posts/<%= post._id %>/edit">Edit</a>
            <form method="POST" action="/admin/posts/<%= post._id %>/delete" style="display:inline;">
              <button class="delete" type="submit">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </body>
</html>
